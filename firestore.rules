rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: ambil role caller dari /users/{uid}
    // Catatan: setiap pemanggilan = 1 read tambahan, hanya dipakai di path yang butuh role check.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdminLike() {
      let r = callerRole();
      return r == 'admin' || r == 'keluarga';
    }

    // Main app data — authenticated users only
    // Catatan: karyawan butuh write di sini untuk update stok lewat persist() saat simpan invoice.
    // Pengamanan field-level (role assignments, suppliers, dll) dilakukan di layer aplikasi (CSS admin-only/strict + guard fungsi).
    match /optik-zada/{document=**} {
      allow read, write: if request.auth != null;
    }

    // User profiles
    // create: self only (Firebase Auth context switches to new user in addPendingUser(),
    //         so admin-created accounts satisfy uid==userId at write time)
    // update: self only AND role field is immutable — prevents privilege escalation
    // delete: any auth user (can't check requester's role without cross-doc reads / Custom Claims)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if request.auth != null;
    }

    // Pre-registered users waiting for first login — authenticated users only
    match /pendingUsers/{email} {
      allow read, write: if request.auth != null;
    }

    // Username → email/uid reverse lookup
    // Public reads: required for username lookup before user is authenticated (login flow)
    // Write requires auth: only admin adds/changes usernames
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-document invoice storage
    // read   : any auth user (semua role butuh lihat riwayat)
    // create : any auth user (karyawan boleh buat invoice baru)
    // update : any auth user, TAPI createdBy immutable (siapapun, termasuk karyawan, tidak bisa rewrite siapa yang membuat invoice)
    // delete : hanya admin & keluarga (defense in depth — di app layer juga sudah ada guard)
    match /invoices/{invId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdminLike();
    }
  }
}
