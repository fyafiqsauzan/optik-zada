rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Main app data — authenticated users only
    match /optik-zada/{document=**} {
      allow read, write: if request.auth != null;
    }

    // User profiles — authenticated users only
    // admin-only management enforced client-side
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Pre-registered karyawan waiting for first login
    match /pendingUsers/{email} {
      allow read, write: if request.auth != null;
    }

    // Username → email/uid reverse lookup for username-based login
    // Public reads: diperlukan untuk lookup sebelum user authenticated (login flow)
    // Write tetap require auth: hanya admin yang bisa tambah/ubah username
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // v8.5: per-document invoice storage — authenticated users only
    match /invoices/{invId} {
      allow read, write: if request.auth != null;
    }
  }
}
