rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Main app data — authenticated users only
    match /optik-zada/{document=**} {
      allow read, write: if request.auth != null;
    }

    // User profiles — authenticated users only
    // admin-only management enforced client-side
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Pre-registered karyawan waiting for first login
    match /pendingUsers/{email} {
      allow read, write: if request.auth != null;
    }
  }
}
